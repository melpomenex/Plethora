<?xml version="1.0" encoding="utf-8"?>
<Package
  IgnorableNamespaces="uap uap10 systemai rescap"
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:systemai="http://schemas.microsoft.com/appx/manifest/systemai/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities">
  <Identity
    Name="Plethora.Plethora"
    Publisher="CN=Plethora Sparse Dev"
    Version="2.7.0.0"
    ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>Plethora</DisplayName>
    <PublisherDisplayName>Plethora</PublisherDisplayName>
    <Logo>Assets\Square44x44Logo.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.26100.0" MaxVersionTested="10.0.26226.0" />
  </Dependencies>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
    <systemai:Capability Name="systemAIModels" />
  </Capabilities>
  <Applications>
    <Application
      Id="Plethora"
      Executable="plethora-tauri.exe"
      uap10:TrustLevel="mediumIL"
      uap10:RuntimeBehavior="win32App">
      <uap:VisualElements
        DisplayName="Plethora"
        Description="Plethora learning application"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>
</Package>
