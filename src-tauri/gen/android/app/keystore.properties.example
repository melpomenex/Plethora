# Copy to keystore.properties (gitignored) and fill in the release keystore
# credentials, or export the equivalent PLETHORA_KEYSTORE_* environment
# variables instead. Never commit the real file.
#
# Generate a new keystore (keep the .keystore file out of git):
#   keytool -genkeypair -v -keystore plethora-release.keystore \
#     -alias plethora-release -keyalg RSA -keysize 2048 -validity 10000
storeFile=plethora-release.keystore
storePassword=CHANGE_ME
keyAlias=plethora-release
keyPassword=CHANGE_ME
