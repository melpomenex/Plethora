{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Incrementum",
        "userAgent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "devtools": true,
        "hiddenTitle": false,
        "dragDropEnabled": true,
        "transparent": true
      }
    ]
  },
  "bundle": {
    "resources": [
      "scripts/anna_download.py",
      "bin/*.so*",
      "bin/notebooklm-runtime"
    ]
  }
}
