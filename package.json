  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vite",
    "dev:pwa": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vite --mode pwa",
    "prebuild": "node scripts/download-sidecars.js && node scripts/build-help-index.mjs",
    "build": "node scripts/build-help-index.mjs && cross-env NODE_OPTIONS=--max-old-space-size=8192 vite build",
    "build:pwa": "vite build --mode pwa",
    "build:check": "node scripts/docs-validate.mjs && node scripts/build-help-index.mjs && tsc && vite build && node scripts/check-bundle-budget.mjs",
    "docs:validate": "node scripts/docs-validate.mjs",
    "docs:coverage": "node scripts/docs-coverage.mjs",
    "docs:build-index": "node scripts/build-help-index.mjs",
    "preview": "vite preview",
    "preview:pwa": "vite preview --mode pwa",
    "tauri": "bash scripts/tauri-wrapper.sh",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:debug": "tauri build --debug",
    "tauri:build:linux": "tauri build --bundles deb,rpm",
    "tauri:build:linux:appimage": "bash scripts/ci-build-appimage.sh",
    "tauri:build:linux:deb": "tauri build --bundles deb",
    "tauri:build:macos": "tauri build --bundles app",
    "tauri:build:macos:dmg": "tauri build --bundles dmg",
    "tauri:build:windows": "tauri build --bundles msi",
    "tauri:build:windows:nsis": "tauri build --bundles nsis",
    "tauri:build:local": "tauri build --config '{\"bundle\":{\"createUpdaterArtifacts\":false},\"plugins\":{\"updater\":{\"active\":false}}}'",
    "tauri:build:local:debug": "tauri build --debug --config '{\"bundle\":{\"createUpdaterArtifacts\":false},\"plugins\":{\"updater\":{\"active\":false}}}'",
    "tauri:build:local:macos": "tauri build --bundles app --config '{\"bundle\":{\"createUpdaterArtifacts\":false},\"plugins\":{\"updater\":{\"active\":false}}}'",
    "tauri:android:init": "tauri android init --ci",
    "tauri:android:dev": "tauri android dev --target aarch64",
    "tauri:android:build": "tauri android build --ci --target aarch64 --apk",
    "tauri:ios:init": "tauri ios init --ci",
    "tauri:ios:dev:sim": "bash scripts/ios-test/bootstrap.sh && tauri ios dev \"iPhone 17 Pro\"",
    "tauri:ios:build:sim": "tauri ios build --ci --target aarch64-sim",
    "tauri:ios:dev:device": "tauri ios dev",
    "tauri:ios:build:device": "tauri ios build --target aarch64",
    "tauri:ios:preflight": "node scripts/ios-release.mjs preflight",
    "tauri:ios:archive": "node scripts/ios-release.mjs archive",
    "tauri:ios:export": "node scripts/ios-release.mjs export",
    "tauri:ios:validate": "node scripts/ios-release.mjs validate",
    "tauri:ios:upload": "node scripts/ios-release.mjs upload",
    "server:dev": "cd server && npm run dev",
    "server:build": "cd server && npm run build",
    "release:downloads": "bash scripts/release-downloads.sh",
    "release:downloads:graph": "bash scripts/release-downloads.sh --graph",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "lint": "eslint . --cache --cache-location .eslintcache",
    "lint:fix": "npm run lint -- --fix",
    "test": "vitest",
    "test:browser-extension": "node --test browser_extension/tests/*.test.cjs",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:wave5:regression": "vitest run src/stores/__tests__/reviewStore.test.ts src/utils/__tests__/fsrsScope.test.ts src/utils/__tests__/reviewInteractions.test.ts src/utils/__tests__/semanticGrading.test.ts src/utils/__tests__/cardQuality.test.ts src/utils/__tests__/referenceImport.test.ts src/lib/__tests__/pluginHost.test.ts src/utils/__tests__/wave4Social.test.ts src/utils/__tests__/reviewAccessibility.test.ts",
    "test:wave5:performance": "vitest run src/utils/__tests__/performance.test.tsx",
    "test:scripts": "node --test scripts/__tests__/*.test.mjs",
    "test:ios:setup": "bash scripts/ios-test/setup.sh",
    "test:ios:smoke": "bash scripts/ios-test/smoke.sh",
    "test:ios:imports": "cd src-tauri && cargo test --test import_robustness",
    "test:ios:e2e": "bash scripts/ios-test/e2e.sh",
    "test:ios:monkey": "node scripts/ios-test/monkey.mjs",
    "test:ios:soak": "bash scripts/ios-test/soak.sh",
    "test:ios:nightly": "bash scripts/ios-test/nightly.sh",
    "test:ios:reset": "bash scripts/ios-test/reset-simulator.sh",
    "test:ios:bisect": "bash scripts/ios-test/bisect-smoke.sh",
    "test:figures": "node scripts/diagnose-pdf-figures.mjs --fixtures",
    "test:visual": "playwright test",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "bench": "vitest bench --run --config vitest.bench.config.ts --outputJson=.bench/results.json --passWithNoTests",
    "bench:memory": "node scripts/memory-bench/driver.js",
    "bench:memory:check": "node scripts/memory-bench/driver.js && node scripts/check-memory-budget.mjs",
    "bench:check": "npm run bench && node scripts/check-perf-budget.mjs && node scripts/check-bundle-budget.mjs"
  },
