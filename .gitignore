# NotebookLM runtime (bundled Python + Playwright - too large for repo)
src-tauri/bin/notebooklm-runtime/**/*
!src-tauri/bin/notebooklm-runtime/.gitkeep
squashfs-root/
incrementum-tauri

# Tauri sidecar binaries — regenerated at build time by scripts/download-sidecars.js.
# Do NOT commit these; they bloat the repo and break Vercel clone (254MB pack).
# Kept un-ignored: whisper-wrapper.sh, notebooklm-* launchers, pocket-tts-* launchers.
src-tauri/bin/ffmpeg-*
src-tauri/bin/whisper-aarch64-*
src-tauri/bin/whisper-armv7-*
src-tauri/bin/whisper-i686-*
src-tauri/bin/whisper-linux
src-tauri/bin/whisper-macos
src-tauri/bin/whisper-universal-*
src-tauri/bin/whisper-x86_64-*
src-tauri/bin/sherpa-onnx-*
src-tauri/bin/.sherpa-onnx-provisioned
src-tauri/bin/libggml*
src-tauri/bin/libwhisper*
src-tauri/bin/libonnxruntime*
# Windows sidecar runtime DLLs (onnxruntime.dll, cargs.dll, sherpa c-api) —
# provisioned at build time, same as the binaries above.
src-tauri/bin/*.dll
src-tauri/bin/*.placeholder.dll
src-tauri/bin/libplaceholder.so
src-tauri/bin/libplaceholder.dylib

# Android assets copied during build
src-tauri/gen/android/app/src/main/assets/

# Local plugin build outputs (Gradle/Kotlin compile artifacts). These are
# regenerated on every build; tracking them causes perpetual binary churn in
# release commits. Matches the build/ dirs under src-tauri/gen/android (already
# ignored) and keeps in-repo Tauri plugins clean.
src-tauri/plugins/*/android/build/
src-tauri/plugins/*/android/.gradle/
src-tauri/plugins/*/ios/build/

# Browser extension build artifacts (separate Node project + compiled .xpi).
# These are not part of the Tauri app and are regenerated from source on demand;
# tracking them would sweep unrelated files into release commits via `git add -A`.
*.xpi
browser_extension/
!browser_extension/
browser_extension/*
!browser_extension/shared.js
!browser_extension/tests/
browser_extension/tests/*
!browser_extension/tests/shared.test.cjs

scratch/
.playwright/

# gauntlet diagnostics (temporary)
debug/
gauntlet-progress.html

# Plethora updater minisign keypair (private key never committed; see
# docs/legacy/updater-key-rotation.md)
src-tauri/keys/
