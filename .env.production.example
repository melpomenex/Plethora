# Plethora Cloud — production environment template
# Copy to .env.production and fill in real values. NEVER commit .env.production.

# ── Core ──────────────────────────────────────────────────────────────────────
PLETHORA_ENV=production
NODE_ENV=production
PORT=3000

# Public API hostname (used by Caddy for TLS certificate)
PLETHORA_API_HOST=api.example.com

# Optional: ACME email for Let's Encrypt (via Caddy)
ACME_EMAIL=ops@example.com

# Docker image (pin a version tag for rollback; avoid mutable latest in prod)
PLETHORA_CLOUD_IMAGE=ghcr.io/melpomenex/plethora-cloud:latest

# ── Database (Neon or other managed PostgreSQL) ───────────────────────────────
# Neon: pooled connection string (-pooler hostname), region eu-central-1, database plethora
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/plethora?sslmode=require
# Neon: direct/unpooled URL for migrations only (no -pooler suffix)
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/plethora?sslmode=require
DATABASE_SSL=true
# Default 8 suits a single ~4 vCPU API VPS; lower per instance when running multiple containers (e.g. 5 × 3 instances)
PG_POOL_MAX=8

# ── Authentication ────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 48
JWT_SECRET=

# Comma-separated production origins (your app/PWA domains)
CORS_ORIGINS=https://app.example.com,https://plethora.app

# ── Object storage (Cloudflare R2, EU jurisdiction) ───────────────────────────
# EU bucket endpoint: https://<ACCOUNT_ID>.eu.r2.cloudflarestorage.com
# Dashboard → R2 → Manage R2 API Tokens → Create (Object Read & Write, bucket-scoped)
S3_ENDPOINT=https://<ACCOUNT_ID>.eu.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=plethora-production
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Observability ─────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
METRICS_TOKEN=

# ── Apple App Store billing ───────────────────────────────────────────────────
APP_STORE_KEY_ID=
APP_STORE_ISSUER_ID=
APP_STORE_PRIVATE_KEY=
APP_STORE_BUNDLE_ID=com.plethora.app
APP_STORE_ENV=production

# ── Google Play billing (Android) ─────────────────────────────────────────────
# Service account JSON (single line) with androidpublisher scope
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PACKAGE_NAME=com.plethora.app
# Pub/Sub push JWT audience — your webhook URL, e.g. https://api.example.com/v1/billing/webhooks/playstore
GOOGLE_PLAY_RTDN_AUDIENCE=

# ── Sync blob offload ─────────────────────────────────────────────────────────
# Ciphertext larger than this (bytes) is stored in R2 instead of Postgres
SYNC_BLOB_OFFLOAD_BYTES=65536

# ── Worker ──────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=2
WORKER_POLL_MS=1000

# ── Legacy routes (keep false in production) ──────────────────────────────────
ENABLE_LEGACY_ROUTES=false
