---
import DemoIsland from '../components/demo/DemoIsland.tsx';
import HomeDemoSlot from '../components/home/HomeDemoSlot.astro';
import { loadLaunchFlags } from '../config/launch.ts';
import BaseLayout from '../layouts/BaseLayout.astro';

const flags = loadLaunchFlags();
---

<BaseLayout
  title="Interactive Plethora product preview"
  description="Try the real Plethora workflow through a guided, accessible product preview."
>
  {
    flags.demoEnabled && flags.showcaseV2Enabled ? (
      <DemoIsland client:load variant="page" search={Astro.url.search} />
    ) : (
      <HomeDemoSlot />
    )
  }
</BaseLayout>
