---
---

<div class="theme-toggle-wrap" data-testid="theme-toggle">
  <fieldset class="theme-toggle-group">
    <legend class="sr-only">Color theme</legend>
    <button
      type="button"
      class="theme-btn"
      data-theme-set="light"
      title="Light theme"
      aria-label="Light theme"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2"></path>
        <path d="M12 20v2"></path>
        <path d="m4.93 4.93 1.41 1.41"></path>
        <path d="m17.66 17.66 1.41 1.41"></path>
        <path d="M2 12h2"></path>
        <path d="M20 12h2"></path>
        <path d="m6.34 17.66-1.41 1.41"></path>
        <path d="m19.07 4.93-1.41 1.41"></path>
      </svg>
      <span class="theme-label">Light</span>
    </button>
    <button
      type="button"
      class="theme-btn"
      data-theme-set="system"
      title="System theme"
      aria-label="System theme"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect width="20" height="14" x="2" y="3" rx="2"></rect>
        <line x1="8" x2="16" y1="21" y2="21"></line>
        <line x1="12" x2="12" y1="17" y2="21"></line>
      </svg>
      <span class="theme-label">Auto</span>
    </button>
    <button
      type="button"
      class="theme-btn"
      data-theme-set="dark"
      title="Dark theme"
      aria-label="Dark theme"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
      </svg>
      <span class="theme-label">Dark</span>
    </button>
  </fieldset>
</div>

<style>
  .theme-toggle-wrap {
    display: inline-flex;
    align-items: center;
  }

  .theme-toggle-group {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 2px;
    margin: 0;
    background: var(--paper-2);
    gap: 2px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .theme-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.25rem 0.5rem;
    border: none;
    background: transparent;
    color: var(--muted);
    font-family: var(--font-ui);
    font-size: 0.75rem;
    font-weight: 500;
    border-radius: var(--radius);
    cursor: pointer;
    line-height: 1;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .theme-btn:hover {
    color: var(--ink);
  }

  .theme-btn[aria-pressed='true'] {
    background: var(--surface-card);
    color: var(--ink);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.08);
  }

  .theme-btn:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 1px;
  }

  @media (max-width: 640px) {
    .theme-label {
      display: none;
    }
    .theme-btn {
      padding: 0.3rem 0.4rem;
    }
  }
</style>

<script>
  function setupThemeToggles() {
    const root = document.documentElement;
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-theme-set]');
    if (!buttons.length) return;

    function refreshActiveButtons() {
      const current = root.dataset.theme || 'system';
      buttons.forEach((btn) => {
        const isCurrent = btn.dataset.themeSet === current;
        btn.setAttribute('aria-pressed', isCurrent ? 'true' : 'false');
      });
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetTheme = btn.dataset.themeSet as 'light' | 'dark' | 'system';
        if (!targetTheme) return;

        localStorage.setItem('plethora-theme', targetTheme);
        root.dataset.theme = targetTheme;

        const isDark =
          targetTheme === 'dark' ||
          (targetTheme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        root.dataset.effectiveTheme = isDark ? 'dark' : 'light';
        root.style.colorScheme = isDark ? 'dark' : 'light';

        refreshActiveButtons();
        window.dispatchEvent(new CustomEvent('plethora-theme-change', { detail: { theme: targetTheme, isDark } }));
      });
    });

    refreshActiveButtons();
  }

  setupThemeToggles();
  document.addEventListener('astro:page-load', setupThemeToggles);
</script>
