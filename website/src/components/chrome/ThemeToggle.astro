---
---

<div class="theme-toggle-wrap" data-testid="theme-toggle">
  <fieldset class="theme-toggle-group">
    <legend class="sr-only">Color theme</legend>
    <button
      type="button"
      class="theme-btn"
      data-theme-set="light"
      title="Light theme"
      aria-label="Light theme"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2"></path>
        <path d="M12 20v2"></path>
        <path d="m4.93 4.93 1.41 1.41"></path>
        <path d="m17.66 17.66 1.41 1.41"></path>
        <path d="M2 12h2"></path>
        <path d="M20 12h2"></path>
        <path d="m6.34 17.66-1.41 1.41"></path>
        <path d="m19.07 4.93-1.41 1.41"></path>
      </svg>
    </button>
    <button
      type="button"
      class="theme-btn"
      data-theme-set="system"
      title="Auto — follow system setting"
      aria-label="Auto — follow system theme"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect width="20" height="14" x="2" y="3" rx="2"></rect>
        <line x1="8" x2="16" y1="21" y2="21"></line>
        <line x1="12" x2="12" y1="17" y2="21"></line>
      </svg>
    </button>
    <button
      type="button"
      class="theme-btn"
      data-theme-set="dark"
      title="Dark theme"
      aria-label="Dark theme"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
      </svg>
    </button>
  </fieldset>
</div>

<style>
  .theme-toggle-wrap {
    display: inline-flex;
    align-items: center;
  }

  /* Compact icon-only segmented control: <= 44px tall, visible selection */
  .theme-toggle-group {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--line);
    border-radius: var(--radius-control);
    padding: 2px;
    margin: 0;
    background: var(--paper-2);
    gap: 2px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .theme-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 30px;
    padding: 0;
    border: none;
    background: transparent;
    color: var(--muted);
    border-radius: calc(var(--radius-control) - 2px);
    cursor: pointer;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .theme-btn:hover {
    color: var(--ink);
  }

  .theme-btn[aria-pressed='true'] {
    background: var(--surface-card);
    color: var(--ink);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.08);
  }

  .theme-btn:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 1px;
  }
</style>

<script>
  import { refreshThemeControls, setupThemeControls } from '../../scripts/theme-control.ts';

  setupThemeControls();
  refreshThemeControls();
  document.addEventListener('astro:page-load', () => {
    setupThemeControls();
    refreshThemeControls();
  });
</script>
