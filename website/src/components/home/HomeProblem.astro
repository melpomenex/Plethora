---
import { COPY } from '../../config/copy.ts';
---

<section id="problem" class="home-section home-problem" aria-labelledby="problem-heading">
  <div class="wrap">
    <h2 id="problem-heading">Saving is not remembering.</h2>
    <p>
      Highlights stack up. Tabs wait. The sentence that actually mattered is still not yours to
      recall. Read-it-later stops when the file is stored.
    </p>
    <p class="journey-line">{COPY.journey}</p>
  </div>
</section>
