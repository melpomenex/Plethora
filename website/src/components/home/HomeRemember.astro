---
import KnowledgePeck from './KnowledgePeck.astro';
---

<section id="remember" class="home-section home-remember" aria-labelledby="remember-heading">
  <div class="wrap remember-layout">
    <div>
      <h2 id="remember-heading">Then keep it.</h2>
      <p data-claim-pending="true">
        A line from the sleep essay becomes a card. Review it later, when it is about to slip:
        basic, cloze, question, multiple choice, image occlusion, spaced over time.
      </p>
    </div>
    <KnowledgePeck />
  </div>
</section>
