---
import DemoIsland from '../demo/DemoIsland.tsx';
import { loadLaunchFlags } from '../../config/launch.ts';

const flags = loadLaunchFlags();
const chapters = [
  ['Collect', 'Build a working library around the things you want to understand.'],
  ['Read', 'Return to the exact passage where recognition and recall diverge.'],
  ['Understand', 'Select the claim in context and work with the real reader actions.'],
  ['Remember', 'Turn the idea into a focused retrieval prompt and grade your recall.'],
  ['Return', 'Schedule the next review and reconnect the idea to nearby knowledge.'],
] as const;
---

{
  flags.showcaseV2Enabled ? (
    <DemoIsland client:visible variant="homepage" />
  ) : (
    <section
      id="demo"
      class="reading-desk-fallback"
      data-home-demo-slot
      data-testid="home-demo-slot"
      data-showcase-v2="fallback"
      aria-labelledby="reading-desk-fallback-title"
    >
      <div class="reading-desk-fallback__intro">
        <p class="reading-desk-fallback__label">Reading Desk</p>
        <h2 id="reading-desk-fallback-title">From first read to useful recall.</h2>
        <p>Follow one licensed, fictional reading through the real Plethora interface.</p>
      </div>
      <picture class="reading-desk-fallback__poster">
        <source
          srcset="/images/showcase/v2/2.0.0-2.7.0+9a6e7dc075b2/library.ready--mobile--390.avif"
          type="image/avif"
        />
        <source
          srcset="/images/showcase/v2/2.0.0-2.7.0+9a6e7dc075b2/library.ready--mobile--390.webp"
          type="image/webp"
        />
        <img
          src="/images/showcase/v2/2.0.0-2.7.0+9a6e7dc075b2/library.ready--mobile--390.png"
          width="390"
          height="844"
          loading="lazy"
          alt="Plethora library with five licensed demo documents and a prioritized next action."
        />
      </picture>
      <ol class="reading-desk-fallback__chapters">
        {chapters.map(([title, body]) => (
          <li>
            <h3>{title}</h3>
            <p>{body}</p>
          </li>
        ))}
      </ol>
      <p class="reading-desk-fallback__actions">
        <a class="btn btn-primary" href="/how-it-works">See how it works</a>
        <a class="btn btn-ghost" href="/downloads">Get Plethora</a>
      </p>
    </section>
  )
}

<style>
  .reading-desk-fallback {
    width: min(var(--wrap), calc(100% - 2 * var(--gutter)));
    margin-inline: auto;
    padding-block: var(--space-8);
    display: grid;
    grid-template-columns: minmax(15rem, 0.72fr) minmax(15rem, 0.48fr) minmax(18rem, 0.9fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: start;
  }

  .reading-desk-fallback__label {
    margin: 0 0 var(--space-3);
    color: var(--plethora-violet-800);
    font: 700 0.78rem/1 var(--font-ui);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .reading-desk-fallback h2 {
    margin: 0 0 var(--space-4);
    max-width: 12ch;
    font: 600 var(--step-5) / 1.04 var(--font-display);
    letter-spacing: -0.04em;
  }

  .reading-desk-fallback p {
    color: var(--ink-soft);
  }

  .reading-desk-fallback__poster {
    display: block;
    overflow: hidden;
    border: 6px solid var(--ink);
    border-radius: 1.5rem;
    background: var(--ink);
    box-shadow: var(--shadow-frame);
  }

  .reading-desk-fallback__poster img {
    display: block;
    width: 100%;
    height: auto;
  }

  .reading-desk-fallback__chapters {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .reading-desk-fallback__chapters li {
    margin-bottom: var(--space-5);
  }

  .reading-desk-fallback__chapters h3 {
    margin: 0 0 0.3rem;
    font: 600 var(--step-2) / 1.15 var(--font-display);
  }

  .reading-desk-fallback__chapters p {
    margin: 0;
  }

  .reading-desk-fallback__actions {
    grid-column: 3;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: calc(-1 * var(--space-4)) 0 0;
  }

  @media (max-width: 64rem), (max-height: 46rem) {
    .reading-desk-fallback {
      grid-template-columns: minmax(0, 1fr) minmax(15rem, 0.65fr);
    }

    .reading-desk-fallback__chapters,
    .reading-desk-fallback__actions {
      grid-column: 1 / -1;
    }

    .reading-desk-fallback__chapters {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-5);
    }
  }

  @media (max-width: 47.99rem) {
    .reading-desk-fallback {
      grid-template-columns: 1fr;
      padding-block: var(--space-7);
    }

    .reading-desk-fallback__poster {
      width: min(100%, 24rem);
      justify-self: center;
    }

    .reading-desk-fallback__chapters {
      display: block;
    }
  }
</style>
