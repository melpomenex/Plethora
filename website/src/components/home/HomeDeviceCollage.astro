---
import { getShowcaseAsset, sourceSet } from '../demo/showcase.ts';

const desk = getShowcaseAsset('library.ready', 'desktop')!;
const phone = getShowcaseAsset('library.ready', 'mobile')!;
---

<div class="device-collage" aria-label="Plethora product scenes">
  <figure class="device-frame device-desk">
    <picture>
      <source type="image/avif" srcset={sourceSet(desk.formats.avif)} sizes="(max-width: 767px) 0px, 448px" />
      <source type="image/webp" srcset={sourceSet(desk.formats.webp)} sizes="(max-width: 767px) 0px, 448px" />
      <img
        src={desk.formats.png.at(-1)!.path}
        alt={desk.accessibleDescription}
        width={desk.intrinsicSize.width}
        height={desk.intrinsicSize.height}
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </picture>
  </figure>
  <figure class="device-frame device-phone">
    <div class="phone-bezel">
      <picture>
        <source type="image/avif" srcset={sourceSet(phone.formats.avif)} sizes="176px" />
        <source type="image/webp" srcset={sourceSet(phone.formats.webp)} sizes="176px" />
        <img
          src={phone.formats.png.at(-1)!.path}
          alt={phone.accessibleDescription}
          width={phone.intrinsicSize.width}
          height={phone.intrinsicSize.height}
          loading="eager"
          decoding="async"
        />
      </picture>
    </div>
  </figure>
</div>
