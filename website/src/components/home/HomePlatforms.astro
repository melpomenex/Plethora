---
import { DOWNLOADS, PLATFORM_LABELS, type DownloadAvailability } from '../../config/downloads.ts';
import { PLATFORM_IDS } from '../../config/platforms.ts';

/** Honest visitor-facing state per manifest status (no manifest-speak). */
function chip(item: DownloadAvailability): string {
  switch (item.status) {
    case 'live':
    case 'store':
      return 'Available';
    case 'coming-soon':
      return 'In final testing';
    case 'disabled':
      return 'Planned';
  }
}
---

<section id="platforms" class="home-section wrap" aria-labelledby="platforms-heading">
  <h2 id="platforms-heading">Desktop and mobile.</h2>
  <p>
    One reading library on every device you use. Plethora is built for the five platforms below.
  </p>
  <ul class="platform-list">
    {
      PLATFORM_IDS.map((id) => {
        const item = DOWNLOADS.platforms[id];
        return (
          <li>
            <strong>{PLATFORM_LABELS[id]}</strong>
            <span class="avail platform-chip" data-status={item.status}>
              {chip(item)}
            </span>
          </li>
        );
      })
    }
  </ul>
</section>
