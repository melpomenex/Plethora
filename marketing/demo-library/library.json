  "notes": [
    {
      "id": "bbbbbbbb-0001-4000-8000-000000000001",
      "documentId": "aaaaaaaa-0001-4000-8000-000000000001",
      "body": "A highlight is a queue, not a memory. Retrieval with the book closed is the test."
    },
    {
      "id": "bbbbbbbb-0002-4000-8000-000000000002",
      "documentId": "aaaaaaaa-0002-4000-8000-000000000002",
      "body": "Sleep replay is biased toward effortful encoding, not toward yellow ink."
    },
    {
      "id": "bbbbbbbb-0003-4000-8000-000000000003",
      "documentId": "aaaaaaaa-0004-4000-8000-000000000004",
      "body": "James: associates are hooks. Isolated rereading leaves nothing to fish with."
    }
  ],
  "extracts": [
    {
      "id": "cccccccc-0001-4000-8000-000000000001",
      "documentId": "aaaaaaaa-0001-4000-8000-000000000001",
      "locator": "essay:fluency",
      "text": "Recognition is cheap. Recall is the skill you actually wanted.",
      "notes": "Turn this contrast into a retrieval prompt.",
      "tags": ["encoding", "retrieval"]
    },
    {
      "id": "cccccccc-0002-4000-8000-000000000002",
      "documentId": "aaaaaaaa-0002-4000-8000-000000000002",
      "locator": "lecture:ch-2",
      "text": "Effort is a teaching signal to the overnight system. Fluency is not.",
      "notes": "Connect effort to overnight replay.",
      "tags": ["sleep", "effort"]
    },
    {
      "id": "cccccccc-0003-4000-8000-000000000003",
      "documentId": "aaaaaaaa-0004-4000-8000-000000000004",
      "locator": "james:hooks",
      "text": "Each of its associates becomes a hook to which it hangs, a means to fish it up by when sunk beneath the surface.",
      "notes": "Association supplies retrieval routes.",
      "tags": ["association", "public-domain"]
    }
  ],
